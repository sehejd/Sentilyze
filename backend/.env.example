# Sentilyze Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# Gemini AI API Configuration (used for AI summaries + SWOT narrative polish)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# --- New data source configuration ---

# SEC EDGAR requires a descriptive User-Agent identifying you/your app + contact email
# per https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT=Sentilyze Personal Use you@example.com

# Optional: enable heavier transformer-based FinBERT sentiment model instead of
# the default VADER + TextBlob ensemble. Requires `pip install -r requirements-ml.txt`.
USE_FINBERT=false

# Optional: real Twitter/X API v2 bearer token. Without it, twitter.py falls back
# to clearly-labeled mock data for local development.
TWITTER_BEARER_TOKEN=

# --- Political "deeper dive" (lobbying + bills + campaign finance) ---

# Optional but recommended: enables bill title/sponsor lookups for the
# political network deep-dive. Free signup at https://api.congress.gov/sign-up/
# Without it, lobbied bill numbers still surface but without title/sponsor detail.
CONGRESS_GOV_API_KEY=

# Optional: FEC campaign finance lookups work out of the box against the
# public DEMO_KEY (rate-limited). For heavier personal use, get a free key at
# https://api.data.gov/signup/ for 1,000 requests/hour.
FEC_API_KEY=

# Senate LDA lobbying disclosure API (lda.senate.gov) is public/keyless -
# no configuration needed.
